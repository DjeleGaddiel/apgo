# Copier ce fichier en .env et l'adapter. Ne jamais commiter le fichier .env.

# API
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://apgo:apgo@localhost:5432/apgo
REDIS_URL=redis://localhost:6379
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=apgo-dev-master-key
# Domaines autorisés à appeler l'API depuis un navigateur, séparés par des virgules
CORS_ORIGINS=http://localhost:4200,http://localhost:4300
# false uniquement en local (http) ; toujours true en production
COOKIE_SECURE=false

# Secrets : générer des valeurs propres à chaque environnement
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TWO_FACTOR_ENCRYPTION_KEY=

# Premier super admin, créé par `npx nx run api:seed` (retirer le mot de passe ensuite)
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=

# Stockage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Images (Cloudinary)
CLOUDINARY_URL=

# Paiement : simulation tant que le super admin n'a pas activé le paiement réel
PAYMENT_PROVIDER=fake
