# Copier ce fichier en .env et l'adapter. Ne jamais commiter le fichier .env.

# API
PORT=3000
DATABASE_URL=postgresql://apgo:apgo@localhost:5432/apgo
REDIS_URL=redis://localhost:6379
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=apgo-dev-master-key

# Stockage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Images (Cloudinary)
CLOUDINARY_URL=

# Paiement : simulation tant que le super admin n'a pas activé le paiement réel
PAYMENT_PROVIDER=fake
