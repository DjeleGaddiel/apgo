                "schema": {
                  "$ref": "#/components/schemas/UserDto"
                }
              }
            }
          }
        },
        "summary": "Réactiver un compte suspendu",
        "tags": [
          "users"
        ]
      }
    },
    "/api/health": {
      "get": {
        "operationId": "Health_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthDto"
                }
              }
            }
          }
        },
        "summary": "État de l’API et de sa base de données",
        "tags": [
          "health"
        ]
      }
    }
  },
  "info": {
    "title": "API APGO",
    "description": "API unique du site, de l’administration et de l’application mobile APGO. Les erreurs suivent toutes le même format : statusCode, code, message, details, requestId.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "apgo_access"
      },
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "AuditActorDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "AuditLogDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "action": {
            "type": "string",
            "example": "user.suspend"
          },
          "targetType": {
            "type": "string",
            "example": "user"
          },
          "targetId": {
            "type": "string",
            "nullable": true
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          },
          "ip": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "actor": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/AuditActorDto"
              }
            ]
          }
        },
        "required": [
          "id",
          "action",
          "targetType",
          "targetId",
          "metadata",
          "ip",
          "createdAt",
          "actor"
        ]
      },
      "AuditLogPageDto": {
        "type": "object",
        "properties": {
          "total": {
            "type": "number"
          },
          "page": {
            "type": "number"
          },
          "pageSize": {
            "type": "number"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditLogDto"
            }
          }
        },
        "required": [
          "total",
          "page",
          "pageSize",
          "items"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ama.kouassi@exemple.ci",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128
          },
          "firstName": {
            "type": "string",
            "example": "Ama",
            "maxLength": 100
          },
          "lastName": {
            "type": "string",
            "example": "Kouassi",
            "maxLength": 100
          },
          "locale": {
            "type": "string",
            "enum": [
              "fr",
              "goa"
            ],
            "default": "fr"
          },
          "client": {
            "type": "string",
            "enum": [
              "web",
              "mobile"
            ],
            "default": "web"
          }
        },
        "required": [
          "email",
          "password",
          "firstName",
          "lastName"
        ]
      },
      "RoleSummaryDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "example": "LEARNER"
          },
          "name": {
            "type": "string",
            "example": "Apprenant"
          }
        },
        "required": [
          "key",
          "name"
        ]
      },
      "CurrentUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "locale": {
            "type": "string",
            "example": "fr"
          },
          "role": {
            "$ref": "#/components/schemas/RoleSummaryDto"
          },
          "permissions": {
            "type": "array",
            "description": "Pour adapter l’interface ; les droits restent vérifiés par l’API.",
            "items": {
              "type": "string",
              "enum": [
                "admin.access",
                "users.read",
                "users.manage",
                "admins.manage",
                "roles.manage",
                "audit.read",
                "settings.manage",
                "payments.switch",
                "payments.read",
                "media.manage",
                "courses.supervise",
                "courses.teach",
                "learning.access",
                "bible.manage",
                "support.handle",
                "certificates.reissue"
              ]
            }
          },
          "twoFactorEnabled": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "email",
          "firstName",
          "lastName",
          "locale",
          "role",
          "permissions",
          "twoFactorEnabled"
        ]
      },
      "AuthResultDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "AUTHENTICATED",
              "TWO_FACTOR_REQUIRED",
              "TWO_FACTOR_SETUP_REQUIRED",
              "PENDING_APPROVAL"
            ]
          },
          "user": {
            "$ref": "#/components/schemas/CurrentUserDto"
          },
          "challengeToken": {
            "type": "string"
          },
          "accessToken": {
            "type": "string",
            "description": "Mobile uniquement."
          },
          "refreshToken": {
            "type": "string",
            "description": "Mobile uniquement."
          },
          "accessTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "status"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ama.kouassi@exemple.ci"
          },
          "password": {
            "type": "string"
          },
          "client": {
            "type": "string",
            "enum": [
              "web",
              "mobile"
            ],
            "default": "web"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "TwoFactorChallengeDto": {
        "type": "object",
        "properties": {
          "challengeToken": {
            "type": "string",
            "description": "Jeton reçu à la connexion (valable 5 minutes)."
          }
        },
        "required": [
          "challengeToken"
        ]
      },
      "TwoFactorSetupDto": {
        "type": "object",
        "properties": {
          "secret": {
            "type": "string",
            "description": "Secret à saisir à la main si le QR code ne peut pas être lu."
          },
          "otpauthUri": {
            "type": "string",
            "description": "Lien `otpauth://` à afficher en QR code."
          }
        },
        "required": [
          "secret",
          "otpauthUri"
        ]
      },
      "TwoFactorVerifyDto": {
        "type": "object",
        "properties": {
          "challengeToken": {
            "type": "string",
            "description": "Jeton reçu à la connexion (valable 5 minutes)."
          },
          "code": {
            "type": "string",
            "example": "123456",
            "description": "Code à 6 chiffres de l’application."
          },
          "client": {
            "type": "string",
            "enum": [
              "web",
              "mobile"
            ],
            "default": "web"
          }
        },
        "required": [
          "challengeToken",
          "code"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          },
          "client": {
            "type": "string",
            "enum": [
              "web",
              "mobile"
            ],
            "default": "web"
          }
        }
      },
      "UserStatus": {
        "type": "string",
        "enum": [
          "PENDING",
          "ACTIVE",
          "SUSPENDED",
          "DELETED"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/UserStatus"
              }
            ]
          },
          "locale": {
            "type": "string",
            "example": "fr"
          },
          "role": {
            "$ref": "#/components/schemas/RoleSummaryDto"
          },
          "twoFactorEnabled": {
            "type": "boolean"
          },
          "lastLoginAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "email",
          "firstName",
          "lastName",
          "status",
          "locale",
          "role",
          "twoFactorEnabled",
          "lastLoginAt",
          "createdAt"
        ]
      },
      "UserPageDto": {
        "type": "object",
        "properties": {
          "total": {
            "type": "number"
          },
          "page": {
            "type": "number"
          },
          "pageSize": {
            "type": "number"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserDto"
            }
          }
        },
        "required": [
          "total",
          "page",
          "pageSize",
          "items"
        ]
      },
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        },
        "required": [
          "status"
        ]
      }
    }
  }
}
